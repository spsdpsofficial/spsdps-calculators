# Copy to .env.local for local work, and set the same names in your host's dashboard.
# IMPORTANT: every NEXT_PUBLIC_* value is shipped to the browser and is PUBLIC.
# Never put secrets or private API keys in a NEXT_PUBLIC_* variable.

# Verified production origin, no trailing slash. Used for canonical, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=

# Search engines may index the site ONLY when this is exactly "true".
# Leave it unset on preview/staging deployments so they are never indexed by accident.
NEXT_PUBLIC_ALLOW_INDEXING=true

# Google Search Console HTML-tag verification token (optional).
NEXT_PUBLIC_GSC_VERIFICATION=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (optional; loads nothing when empty).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Set to "true" only AFTER AdSense approval and after wiring real ad units in components/ads/AdSlot.js.
NEXT_PUBLIC_ADS_ENABLED=false

# Public contact email shown on the Contact page (optional until launch).
NEXT_PUBLIC_CONTACT_EMAIL=spsdps.official@gmail.com
