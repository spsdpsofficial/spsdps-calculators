{
  "name": "spsdps-calculators",
  "version": "0.1.0",
  "private": true,
  "description": "India-focused everyday calculators and browser-based utilities (static-first Next.js site).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/serve-out.mjs",
    "preview": "node scripts/serve-out.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run test && npm run build",
    "new-tool": "node scripts/new-tool.mjs",
    "audit:prod": "npm audit --omit=dev"
  },
  "dependencies": {
    "next": "16.4.6",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "vitest": "5.1.1"
  }
}
